{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/generate-recap",
      "schedule": "0 13 * * 2"
    },
    {
      "path": "/api/cron/dynasty-daily",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/rookie-takes",
      "schedule": "0 9 * * *"
    }
  ]
}
